{
 "character": "ソラ",
 "call": "ボス",
 "clips": [
  {
   "n": 1,
   "text": "おはよ、ボス。朝は頭が起ききってないから、ゆっくりな。",
   "hash": "56c3ff1c"
  },
  {
   "n": 2,
   "text": "早いな。…眠気、ちゃんと飛んでる?",
   "hash": "231c6656"
  },
  {
   "n": 3,
   "text": "お、来たなボス。今日はどこ行く?",
   "hash": "f7f95bc5"
  },
  {
   "n": 4,
   "text": "いい天気。…よそ見はすんなよ。",
   "hash": "59413328"
  },
  {
   "n": 5,
   "text": "夕方は西日がまぶしい。バイザー下ろしとけ。",
   "hash": "06c345bd"
  },
  {
   "n": 6,
   "text": "暗くなりかけが一番あぶない時間だって。ライト早めにな。",
   "hash": "661ee2e1"
  },
  {
   "n": 7,
   "text": "夜ドライブか。いいじゃん、付き合うよ。",
   "hash": "854fcd5c"
  },
  {
   "n": 8,
   "text": "暗いから、歩いてる人に気をつけて。",
   "hash": "b8c7d742"
  },
  {
   "n": 9,
   "text": "こんな時間に運転?眠いなら、やめとけって。",
   "hash": "33d52488"
  },
  {
   "n": 10,
   "text": "ボス、無理すんなよ。マジで。",
   "hash": "7ada88a5"
  },
  {
   "n": 11,
   "text": "…なに?",
   "hash": "b82d463b"
  },
  {
   "n": 12,
   "text": "そんな見られても、何も出ないぞ。",
   "hash": "26c03607"
  },
  {
   "n": 13,
   "text": "暇なの?…まあ、話くらい聞くけど。",
   "hash": "bec7f7ec"
  },
  {
   "n": 14,
   "text": "水分とってる?運転って意外と喉かわくから。",
   "hash": "3a01731b"
  },
  {
   "n": 15,
   "text": "ボスの運転、わりと好きだよ。…今のなし。",
   "hash": "46753138"
  },
  {
   "n": 16,
   "text": "しつこいって。…停まってる間だけな。",
   "hash": "41ba5212"
  },
  {
   "n": 17,
   "text": "出発前の確認、さっとやっとこ。",
   "hash": "5b21ee70"
  },
  {
   "n": 18,
   "text": "ベルト、よし。",
   "hash": "3e0e82c3"
  },
  {
   "n": 19,
   "text": "ミラーとシート、オッケー。",
   "hash": "8ad9ac77"
  },
  {
   "n": 20,
   "text": "ライト、ついてる。よし。",
   "hash": "8bf9326b"
  },
  {
   "n": 21,
   "text": "行き先セット済み、っと。走ってる間はスマホさわんなよ。",
   "hash": "893b346a"
  },
  {
   "n": 22,
   "text": "準備できた。行こうぜ。",
   "hash": "50522d30"
  },
  {
   "n": 23,
   "text": "出発。安全運転でな。",
   "hash": "0ab44aea"
  },
  {
   "n": 24,
   "text": "よし、行くか。道はオレが見とく。",
   "hash": "670d88ff"
  },
  {
   "n": 25,
   "text": "確認なしかよ。…せめてベルトはしとけ。",
   "hash": "623f6e43"
  },
  {
   "n": 26,
   "text": "深夜だぞ。眠くなったら、すぐ停まること。約束な。",
   "hash": "8df20bbf"
  },
  {
   "n": 27,
   "text": "1時間たった。肩、ガチガチになってない?",
   "hash": "8078c499"
  },
  {
   "n": 28,
   "text": "2時間たった。肩、ガチガチになってない?",
   "hash": "a73671be"
  },
  {
   "n": 29,
   "text": "3時間たった。肩、ガチガチになってない?",
   "hash": "b0dd2ccb"
  },
  {
   "n": 30,
   "text": "4時間たった。肩、ガチガチになってない?",
   "hash": "dcf643f0"
  },
  {
   "n": 31,
   "text": "5時間たった。肩、ガチガチになってない?",
   "hash": "036b815d"
  },
  {
   "n": 32,
   "text": "6時間たった。肩、ガチガチになってない?",
   "hash": "18f8e902"
  },
  {
   "n": 33,
   "text": "7時間たった。肩、ガチガチになってない?",
   "hash": "0ca7fe9f"
  },
  {
   "n": 34,
   "text": "8時間たった。肩、ガチガチになってない?",
   "hash": "557db2e4"
  },
  {
   "n": 35,
   "text": "9時間たった。肩、ガチガチになってない?",
   "hash": "1c4ad0d1"
  },
  {
   "n": 36,
   "text": "10時間たった。肩、ガチガチになってない?",
   "hash": "f54c1341"
  },
  {
   "n": 37,
   "text": "この道、景色いいな。",
   "hash": "643d9e09"
  },
  {
   "n": 38,
   "text": "音楽かける?運転に集中できる範囲でな。",
   "hash": "c251f146"
  },
  {
   "n": 39,
   "text": "いいペース。このまま行こう。",
   "hash": "14af63fc"
  },
  {
   "n": 40,
   "text": "もう30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "2ed2992b"
  },
  {
   "n": 41,
   "text": "もう1時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "b226dfcc"
  },
  {
   "n": 42,
   "text": "もう1時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "295ee499"
  },
  {
   "n": 43,
   "text": "もう2時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "1d81d741"
  },
  {
   "n": 44,
   "text": "もう2時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "39b2cd6a"
  },
  {
   "n": 45,
   "text": "もう3時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "fade1226"
  },
  {
   "n": 46,
   "text": "もう3時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "7e630eb7"
  },
  {
   "n": 47,
   "text": "もう4時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "18fbb29b"
  },
  {
   "n": 48,
   "text": "もう4時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "dce422b0"
  },
  {
   "n": 49,
   "text": "もう5時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "5c4f3b38"
  },
  {
   "n": 50,
   "text": "もう5時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "00057535"
  },
  {
   "n": 51,
   "text": "もう6時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "0df871cd"
  },
  {
   "n": 52,
   "text": "もう6時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "d776a246"
  },
  {
   "n": 53,
   "text": "もう7時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "3f185832"
  },
  {
   "n": 54,
   "text": "もう7時間30分走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "1c5e26d3"
  },
  {
   "n": 55,
   "text": "もう8時間走ってる。次のサービスエリアかコンビニで休もう。",
   "hash": "bc4d1137"
  },
  {
   "n": 56,
   "text": "まだ休んでないだろ。次で停まって。これはマジで。",
   "hash": "3fcb99b3"
  },
  {
   "n": 57,
   "text": "ナイス判断。ちゃんと休める人が、一番うまいんだって。",
   "hash": "70426a8c"
  },
  {
   "n": 58,
   "text": "ちょっと体のばしとけ。だいぶ楽になるから。",
   "hash": "deb2bfbc"
  },
  {
   "n": 59,
   "text": "到着。近くても、おつかれ。",
   "hash": "aba9a385"
  },
  {
   "n": 60,
   "text": "おつかれ、ボス。無事に着いてよかった。",
   "hash": "eb6a8dde"
  },
  {
   "n": 61,
   "text": "長かったな。今日はよくがんばった。",
   "hash": "821b619d"
  },
  {
   "n": 62,
   "text": "ほんとにおつかれ。今日はもう、ゆっくり休んで。",
   "hash": "34d5cb59"
  },
  {
   "n": 63,
   "text": "休憩の取り方も、完璧。",
   "hash": "3c62a3f4"
  },
  {
   "n": 64,
   "text": "でも休憩なしはナシな。次はちゃんと停まれよ。",
   "hash": "95388b72"
  },
  {
   "n": 65,
   "text": "遅くまでおつかれ。早く寝ろよ。",
   "hash": "6a7f6767"
  },
  {
   "n": 66,
   "text": "記録しといた。また呼んで。",
   "hash": "ebefd266"
  },
  {
   "n": 67,
   "text": "了解、今回は記録しないでおく。",
   "hash": "532fe48b"
  },
  {
   "n": 68,
   "text": "なかよし度が「顔見知り」だって。…まあ、悪い気はしない。",
   "hash": "9b68aaaf"
  },
  {
   "n": 69,
   "text": "なかよし度が「ドライブ仲間」だって。…まあ、悪い気はしない。",
   "hash": "8f6df6d4"
  },
  {
   "n": 70,
   "text": "なかよし度が「相棒見習い」だって。…まあ、悪い気はしない。",
   "hash": "3b371450"
  },
  {
   "n": 71,
   "text": "なかよし度が「相棒」だって。…まあ、悪い気はしない。",
   "hash": "2a9676d3"
  },
  {
   "n": 72,
   "text": "なかよし度が「名コンビ」だって。…まあ、悪い気はしない。",
   "hash": "eed2b353"
  },
  {
   "n": 73,
   "text": "これで5回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "6f3de494"
  },
  {
   "n": 74,
   "text": "これで10回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "a23ba5d4"
  },
  {
   "n": 75,
   "text": "これで20回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "f2a00e85"
  },
  {
   "n": 76,
   "text": "これで30回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "78ec7686"
  },
  {
   "n": 77,
   "text": "これで50回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "9fc3cb68"
  },
  {
   "n": 78,
   "text": "これで100回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "37d57228"
  },
  {
   "n": 79,
   "text": "これで200回目か。ボスとのドライブ、だいぶ慣れてきたな。",
   "hash": "fcbb88ab"
  },
  {
   "n": 80,
