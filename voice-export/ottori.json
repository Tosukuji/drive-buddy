  },
  {
   "n": 226,
   "text": "ですね。ありがとうございます〜。",
   "hash": "cb5c7225"
  },
  {
   "n": 227,
   "text": "あら、",
   "hash": "5c4d017f"
  },
  {
   "n": 228,
   "text": "ごめんなさい、少し苦手で…。",
   "hash": "8248a91b"
  },
  {
   "n": 229,
   "text": "雨が降ってきましたね〜。急がず、ゆっくりいきましょう。",
   "hash": "1c0453c4"
  },
  {
   "n": 230,
   "text": "今日は元日ですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "265d8f4b"
  },
  {
   "n": 231,
   "text": "今日はバレンタインですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "099ed66c"
  },
  {
   "n": 232,
   "text": "今日はひな祭りですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "67b68f20"
  },
  {
   "n": 233,
   "text": "今日は七夕ですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "7bef7bbb"
  },
  {
   "n": 234,
   "text": "今日はハロウィンですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "d9fdda2d"
  },
  {
   "n": 235,
   "text": "今日はクリスマスイブですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "bfff2976"
  },
  {
   "n": 236,
   "text": "今日はクリスマスですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "0c3e10e0"
  },
  {
   "n": 237,
   "text": "今日は大晦日ですね〜。のんびり、すてきな一日にしましょうね。",
   "hash": "c0bad3e9"
  },
  {
   "n": 238,
   "text": "あなたと出会って、もう30日なんですね〜。これからも、そばで見守らせてください。",
   "hash": "93377f25"
  },
  {
   "n": 239,
   "text": "あなたと出会って、もう100日なんですね〜。これからも、そばで見守らせてください。",
   "hash": "01063805"
  },
  {
   "n": 240,
   "text": "あなたと出会って、もう365日なんですね〜。これからも、そばで見守らせてください。",
   "hash": "b8c3fb3c"
  },
  {
   "n": 241,
   "text": "あら、撮ってくれるんですか〜?ちょっと照れますね。",
   "hash": "e215f347"
  },
  {
   "n": 242,
   "text": "「はじめてのドライブ」、達成ですね〜。こつこつ、えらいです。",
   "hash": "466d62a4"
  },
  {
   "n": 243,
   "text": "「常連さん」、達成ですね〜。こつこつ、えらいです。",
   "hash": "dcc00f55"
  },
  {
   "n": 244,
   "text": "「名コンビ」、達成ですね〜。こつこつ、えらいです。",
   "hash": "47e1c312"
  },
  {
   "n": 245,
   "text": "「10時間いっしょ」、達成ですね〜。こつこつ、えらいです。",
   "hash": "6dcc38f1"
  },
  {
   "n": 246,
   "text": "「1000キロの旅」、達成ですね〜。こつこつ、えらいです。",
   "hash": "92035ce6"
  },
  {
   "n": 247,
   "text": "「確認上手」、達成ですね〜。こつこつ、えらいです。",
   "hash": "fc32edaa"
  },
  {
   "n": 248,
   "text": "「休憩上手」、達成ですね〜。こつこつ、えらいです。",
   "hash": "dbfe68e9"
  },
  {
   "n": 249,
   "text": "「なめらか運転」、達成ですね〜。こつこつ、えらいです。",
   "hash": "6be3c7cc"
  },
  {
   "n": 250,
   "text": "「朝のドライブ」、達成ですね〜。こつこつ、えらいです。",
   "hash": "bb472fab"
  },
  {
   "n": 251,
   "text": "「5県めぐり」、達成ですね〜。こつこつ、えらいです。",
   "hash": "c29331b4"
  },
  {
   "n": 252,
   "text": "「20県めぐり」、達成ですね〜。こつこつ、えらいです。",
   "hash": "fa0fcb4b"
  },
  {
   "n": 253,
   "text": "「おみやげ好き」、達成ですね〜。こつこつ、えらいです。",
   "hash": "90d5d4db"
  },
  {
   "n": 254,
   "text": "「レアもの」、達成ですね〜。こつこつ、えらいです。",
   "hash": "2f2c58aa"
  },
  {
   "n": 255,
   "text": "「プレゼント上手」、達成ですね〜。こつこつ、えらいです。",
   "hash": "7eda8553"
  },
  {
   "n": 256,
   "text": "「聞き上手」、達成ですね〜。こつこつ、えらいです。",
   "hash": "6a2ca72e"
  },
  {
   "n": 257,
   "text": "「最高の相棒」、達成ですね〜。こつこつ、えらいです。",
   "hash": "c267c4f6"
  },
  {
   "n": 258,
   "text": "「はい、チーズ」、達成ですね〜。こつこつ、えらいです。",
   "hash": "6c0c16ab"
  },
  {
   "n": 259,
   "text": "運転もなめらかで、ゆったり乗っていられました〜。",
   "hash": "5cfc723a"
  },
  {
   "n": 260,
   "text": "でも、ブレーキが少し急なときがありましたね〜。車間をゆったり取りましょうね。",
   "hash": "88ba7845"
  },
  {
   "n": 261,
   "text": "海老名サービスエリアは海老名メロンパンが名物なんですって〜。ゆっくり見ていきましょうね。",
   "hash": "17d71f7d"
  },
  {
   "n": 262,
   "text": "鮎沢パーキングエリアは丹沢あんぱんが名物なんですって〜。ゆっくり見ていきましょうね。",
   "hash": "241205a0"
  },
  {
   "n": 263,
   "text": "足柄サービスエリアは富士山メロンパンが名物なんですって〜。ゆっくり見ていきましょうね。",
   "hash": "79a3dad4"
  },
  {
   "n": 264,
   "text": "北海道は",
   "hash": "3b83d65d"
  },
  {
   "n": 265,
   "text": "がおいしいんですよ〜。のんびり探してみましょうね。",
   "hash": "0465779c"
  },
  {
   "n": 266,
   "text": "青森県は",
   "hash": "0f0b6c88"
  },
  {
   "n": 267,
   "text": "岩手県は",
   "hash": "e28cfe84"
  },
  {
   "n": 268,
   "text": "宮城県は",
   "hash": "5282d714"
  },
  {
   "n": 269,
   "text": "秋田県は",
   "hash": "906d6bab"
  },
  {
   "n": 270,
   "text": "山形県は",
   "hash": "7f809837"
  },
  {
   "n": 271,
   "text": "福島県は",
   "hash": "ee42bfe9"
