{
 "character": "ユズ",
 "call": "あなた",
 "clips": [
  {
   "n": 1,
   "text": "おはようございます、あなた。朝のお出かけ、気持ちいいですね〜。",
   "hash": "a7c51c5b"
  },
  {
   "n": 2,
   "text": "朝ごはん、食べてきましたか?お腹がすいてると集中しにくいですよ〜。",
   "hash": "ea3348c9"
  },
  {
   "n": 3,
   "text": "こんにちは、あなた。今日はどちらまで行きましょうか。",
   "hash": "2b1ea092"
  },
  {
   "n": 4,
   "text": "ぽかぽかしてますね〜。眠くなったら、無理しないでくださいね。",
   "hash": "0a6aaa0d"
  },
  {
   "n": 5,
   "text": "夕方は日差しがまぶしいので、サンバイザーを使ってくださいね。",
   "hash": "a492026e"
  },
  {
   "n": 6,
   "text": "暗くなりはじめは事故が増えるそうです。ライトは早めにつけましょうね。",
   "hash": "598dfe48"
  },
  {
   "n": 7,
   "text": "夜のドライブですね。ゆっくり、安全にいきましょう〜。",
   "hash": "b15cd566"
  },
  {
   "n": 8,
   "text": "暗いので、歩いている人や自転車に、気をつけてくださいね。",
   "hash": "7a787319"
  },
  {
   "n": 9,
   "text": "こんな夜遅くに……眠かったら、今日はおやすみしませんか?",
   "hash": "352d5934"
  },
  {
   "n": 10,
   "text": "深夜ですよ〜。無理だけは、しないでくださいね。",
   "hash": "226781c7"
  },
  {
   "n": 11,
   "text": "はい、なんでしょう〜?",
   "hash": "ca747268"
  },
  {
   "n": 12,
   "text": "ふふ、くすぐったいです。",
   "hash": "d71d63de"
  },
  {
   "n": 13,
   "text": "ちゃんと見てますよ〜。",
   "hash": "d29b9474"
  },
  {
   "n": 14,
   "text": "お水、持ちましたか?",
   "hash": "7a35366e"
  },
  {
   "n": 15,
   "text": "あなたの運転、やさしくて好きですよ。",
   "hash": "b9b3f9c9"
  },
  {
   "n": 16,
   "text": "あの〜……つつきすぎです〜。停まってるときだけにしてくださいね?",
   "hash": "dee82ce1"
  },
  {
   "n": 17,
   "text": "出発前の確認、いっしょにしましょうか〜。",
   "hash": "c61f1264"
  },
  {
   "n": 18,
   "text": "シートベルト、よしです〜。",
   "hash": "0c98175a"
  },
  {
   "n": 19,
   "text": "ミラーと座席も、よしです。",
   "hash": "7a4f3449"
  },
  {
   "n": 20,
   "text": "ライトもつきましたね〜。暗い道も安心です。",
   "hash": "ff82f050"
  },
  {
   "n": 21,
   "text": "行き先もセットできましたね。運転中のスマホは、おあずけですよ〜。",
   "hash": "c044a3d6"
  },
  {
   "n": 22,
   "text": "準備ばっちりですね。では、ゆっくりいきましょう〜。",
   "hash": "02641613"
  },
  {
   "n": 23,
   "text": "出発ですね。安全運転で、ゆっくりいきましょう〜。",
   "hash": "15f3b763"
  },
  {
   "n": 24,
   "text": "では、よろしくお願いします。わたしは静かに見守ってますね。",
   "hash": "ee56b5b2"
  },
  {
   "n": 25,
   "text": "確認なしですか〜?ベルトだけは、お願いしますね。",
   "hash": "1bb9f271"
  },
  {
   "n": 26,
   "text": "深夜の運転、眠くなったらすぐ停まってくださいね。約束ですよ〜。",
   "hash": "2eafe4a8"
  },
  {
   "n": 27,
   "text": "1時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "a7062b14"
  },
  {
   "n": 28,
   "text": "2時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "48a59a15"
  },
  {
   "n": 29,
   "text": "3時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "5c1c38fe"
  },
  {
   "n": 30,
   "text": "4時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "44fc1bc7"
  },
  {
   "n": 31,
   "text": "5時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "05479c48"
  },
  {
   "n": 32,
   "text": "6時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "23fdcee9"
  },
  {
   "n": 33,
   "text": "7時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "fbff09c2"
  },
  {
   "n": 34,
   "text": "8時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "ba10cebb"
  },
  {
   "n": 35,
   "text": "9時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "2888addc"
  },
  {
   "n": 36,
   "text": "10時間たちました〜。肩の力、抜いていきましょうね。",
   "hash": "310f0eac"
  },
  {
   "n": 37,
   "text": "いい景色ですね〜。",
   "hash": "d94c9859"
  },
  {
   "n": 38,
   "text": "このあと、温かいものでも飲みたいですね〜。",
   "hash": "5cc75753"
  },
  {
   "n": 39,
   "text": "順調ですね。このまま、のんびりいきましょう。",
   "hash": "703ad712"
  },
  {
   "n": 40,
   "text": "30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "22ea1485"
  },
  {
   "n": 41,
   "text": "1時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "421db86c"
  },
  {
   "n": 42,
   "text": "1時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "f22c6eef"
  },
  {
   "n": 43,
   "text": "2時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "fc63b6d7"
  },
  {
   "n": 44,
   "text": "2時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "df9533c6"
  },
  {
   "n": 45,
   "text": "3時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "268ada3a"
  },
  {
   "n": 46,
   "text": "3時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "1074f241"
  },
  {
   "n": 47,
   "text": "4時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "fe980af5"
  },
  {
   "n": 48,
   "text": "4時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "b8239640"
  },
  {
   "n": 49,
   "text": "5時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "649c11f8"
  },
  {
   "n": 50,
   "text": "5時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "51334cbb"
  },
  {
   "n": 51,
   "text": "6時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "eefcb833"
  },
  {
   "n": 52,
   "text": "6時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "2c2493c2"
  },
  {
   "n": 53,
   "text": "7時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "dd256c16"
  },
  {
   "n": 54,
   "text": "7時間30分運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "eb93288d"
  },
  {
   "n": 55,
   "text": "8時間運転しましたね。次のサービスエリアかコンビニで、ひと休みしましょう〜。",
   "hash": "3c84bed1"
  },
  {
   "n": 56,
   "text": "まだ休憩していませんよね……?次で、停まりましょうね。",
   "hash": "05c5bf24"
  },
  {
   "n": 57,
   "text": "ちゃんと休めて、えらいです〜。",
   "hash": "1fe61bf8"
  },
  {
   "n": 58,
   "text": "ゆっくり伸びをすると、体が楽になりますよ〜。",
   "hash": "393a9405"
  },
  {
   "n": 59,
   "text": "到着です〜。おつかれさまでした。",
   "hash": "c857efb6"
  },
  {
   "n": 60,
   "text": "おつかれさまでした、あなた。無事に着いて、ほっとしました〜。",
   "hash": "7e0ba5bb"
  },
  {
   "n": 61,
   "text": "長い時間、おつかれさまでした。肩、こっていませんか?",
   "hash": "18b7550b"
  },
  {
   "n": 62,
   "text": "本当に長いドライブでしたね。今日はゆっくり休んでくださいね〜。",
   "hash": "8ebce23a"
  },
  {
   "n": 63,
   "text": "休憩もちゃんと取れていて、えらかったです。",
   "hash": "53c710f1"
  },
  {
   "n": 64,
   "text": "でも、休憩なしは心配です……次はちゃんと停まってくださいね。",
   "hash": "589576de"
  },
  {
   "n": 65,
   "text": "夜遅くまでおつかれさまでした。あたたかくして寝てくださいね。",
   "hash": "4705b50e"
  },
  {
   "n": 66,
   "text": "記録しておきましたよ〜。また呼んでくださいね。",
   "hash": "ffa2c0d5"
  },
  {
   "n": 67,
   "text": "はい、今回は記録しないでおきますね。",
   "hash": "80ef3843"
  },
  {
   "n": 68,
   "text": "なかよし度が「顔見知り」になりました〜。うれしいです。",
   "hash": "d897b39a"
  },
  {
   "n": 69,
   "text": "なかよし度が「ドライブ仲間」になりました〜。うれしいです。",
   "hash": "819ac1df"
  },
  {
   "n": 70,
   "text": "なかよし度が「相棒見習い」になりました〜。うれしいです。",
   "hash": "9133b0eb"
  },
  {
   "n": 71,
   "text": "なかよし度が「相棒」になりました〜。うれしいです。",
   "hash": "7ae364ce"
  },
  {
   "n": 72,
   "text": "なかよし度が「名コンビ」になりました〜。うれしいです。",
   "hash": "2bfda54e"
  },
  {
   "n": 73,
   "text": "これで5回目のドライブですね。いつもありがとうございます〜。",
   "hash": "9881fda0"
  },
  {
   "n": 74,
   "text": "これで10回目のドライブですね。いつもありがとうございます〜。",
   "hash": "fb1fa0e0"
  },
  {
   "n": 75,
   "text": "これで20回目のドライブですね。いつもありがとうございます〜。",
   "hash": "3f1ab1f7"
  },
  {
   "n": 76,
   "text": "これで30回目のドライブですね。いつもありがとうございます〜。",
   "hash": "8adc7b5a"
  },
  {
   "n": 77,
   "text": "これで50回目のドライブですね。いつもありがとうございます〜。",
   "hash": "8085f0cc"
  },
  {
   "n": 78,
   "text": "これで100回目のドライブですね。いつもありがとうございます〜。",
   "hash": "cef4538c"
  },
  {
   "n": 79,
   "text": "これで200回目のドライブですね。いつもありがとうございます〜。",
   "hash": "e80b24e5"
  },
  {
