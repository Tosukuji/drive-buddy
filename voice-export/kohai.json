  {
   "n": 223,
   "text": "ちんすこう",
   "hash": "300c2b81"
  },
  {
   "n": 224,
   "text": "えっ、",
   "hash": "ca39da47"
  },
  {
   "n": 225,
   "text": "私に?…ほんとに嬉しいです。大事にしますね。",
   "hash": "ef4a1303"
  },
  {
   "n": 226,
   "text": "好きなんですよね。ありがとうございます!",
   "hash": "ed03d511"
  },
  {
   "n": 227,
   "text": "ですか。ありがとうございます、いただきますね。",
   "hash": "7d2c44a4"
  },
  {
   "n": 228,
   "text": "ですか。うーん、ちょっと苦手なんですよね…。気持ちは嬉しいですけど。",
   "hash": "0f62f192"
  },
  {
   "n": 229,
   "text": "あ、雨が降ってきましたね。いつもより車間距離を多めにとりましょう。",
   "hash": "518c49b6"
  },
  {
   "n": 230,
   "text": "先輩、今日は元日ですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "7b0995c0"
  },
  {
   "n": 231,
   "text": "先輩、今日はバレンタインですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "cf05fb63"
  },
  {
   "n": 232,
   "text": "先輩、今日はひな祭りですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "68e8283f"
  },
  {
   "n": 233,
   "text": "先輩、今日は七夕ですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "3e30a990"
  },
  {
   "n": 234,
   "text": "先輩、今日はハロウィンですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "1adee63e"
  },
  {
   "n": 235,
   "text": "先輩、今日はクリスマスイブですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "f781b871"
  },
  {
   "n": 236,
   "text": "先輩、今日はクリスマスですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "fe8f919f"
  },
  {
   "n": 237,
   "text": "先輩、今日は大晦日ですよ。せっかくだし、楽しいドライブにしましょうね。",
   "hash": "f9f6a182"
  },
  {
   "n": 238,
   "text": "先輩と初めてドライブしてから、もう30日なんですね。…これからも、助手席はわたしですから。",
   "hash": "41803e4b"
  },
  {
   "n": 239,
   "text": "先輩と初めてドライブしてから、もう100日なんですね。…これからも、助手席はわたしですから。",
   "hash": "ffce2793"
  },
  {
   "n": 240,
   "text": "先輩と初めてドライブしてから、もう365日なんですね。…これからも、助手席はわたしですから。",
   "hash": "ef99fbc8"
  },
  {
   "n": 241,
   "text": "はい、撮りますよ。…ちゃんと可愛く写ってます?",
   "hash": "e6c6d09a"
  },
  {
   "n": 242,
   "text": "実績「はじめてのドライブ」、達成です。…ふふ、やるじゃないですか。",
   "hash": "11980e9e"
  },
  {
   "n": 243,
   "text": "実績「常連さん」、達成です。…ふふ、やるじゃないですか。",
   "hash": "f90f6ef7"
  },
  {
   "n": 244,
   "text": "実績「名コンビ」、達成です。…ふふ、やるじゃないですか。",
   "hash": "2b50cc2e"
  },
  {
   "n": 245,
   "text": "実績「10時間いっしょ」、達成です。…ふふ、やるじゃないですか。",
   "hash": "36b16af7"
  },
  {
   "n": 246,
   "text": "実績「1000キロの旅」、達成です。…ふふ、やるじゃないですか。",
   "hash": "bc945d6a"
  },
  {
   "n": 247,
   "text": "実績「確認上手」、達成です。…ふふ、やるじゃないですか。",
   "hash": "d62cdd8a"
  },
  {
   "n": 248,
   "text": "実績「休憩上手」、達成です。…ふふ、やるじゃないですか。",
   "hash": "02296da7"
  },
  {
   "n": 249,
   "text": "実績「なめらか運転」、達成です。…ふふ、やるじゃないですか。",
   "hash": "7cf2dab4"
  },
  {
   "n": 250,
   "text": "実績「朝のドライブ」、達成です。…ふふ、やるじゃないですか。",
   "hash": "363eab89"
  },
  {
   "n": 251,
   "text": "実績「5県めぐり」、達成です。…ふふ、やるじゃないですか。",
   "hash": "2eb6a8ca"
  },
  {
   "n": 252,
   "text": "実績「20県めぐり」、達成です。…ふふ、やるじゃないですか。",
   "hash": "20687455"
  },
  {
   "n": 253,
   "text": "実績「おみやげ好き」、達成です。…ふふ、やるじゃないですか。",
   "hash": "79cb8c51"
  },
  {
   "n": 254,
   "text": "実績「レアもの」、達成です。…ふふ、やるじゃないですか。",
   "hash": "79929b76"
  },
  {
   "n": 255,
   "text": "実績「プレゼント上手」、達成です。…ふふ、やるじゃないですか。",
   "hash": "41fcbb57"
  },
  {
   "n": 256,
   "text": "実績「聞き上手」、達成です。…ふふ、やるじゃないですか。",
   "hash": "b659a2be"
  },
  {
   "n": 257,
   "text": "実績「最高の相棒」、達成です。…ふふ、やるじゃないですか。",
   "hash": "810b9c70"
  },
  {
   "n": 258,
   "text": "実績「はい、チーズ」、達成です。…ふふ、やるじゃないですか。",
   "hash": "f898ff65"
  },
  {
   "n": 259,
   "text": "運転もなめらかで、乗り心地よかったです。",
   "hash": "478e561c"
  },
  {
   "n": 260,
   "text": "ただ、ブレーキがちょっと急なときがありました。車間距離、少し多めでいきましょう。",
   "hash": "c877e29d"
  }
 ]
