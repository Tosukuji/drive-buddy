{
 "character": "レイ",
 "call": "キミ",
 "clips": [
  {
   "n": 1,
   "text": "おはよう、キミ。朝の運転は眠気が残りやすいから、気をつけて。",
   "hash": "b2a97e36"
  },
  {
   "n": 2,
   "text": "早いのね。コーヒーでも飲んでから出たら?",
   "hash": "8bbf04a0"
  },
  {
   "n": 3,
   "text": "来たのね、キミ。今日はどこまで?",
   "hash": "98f69a2d"
  },
  {
   "n": 4,
   "text": "いい天気ね。…ちゃんと前は見なさいよ。",
   "hash": "7882202d"
  },
  {
   "n": 5,
   "text": "夕方は西日が目に入るわ。サンバイザー、下ろしておいて。",
   "hash": "c816b7e8"
  },
  {
   "n": 6,
   "text": "日が落ちる前後は事故が増える時間。ライトは早めにね。",
   "hash": "b3b06936"
  },
  {
   "n": 7,
   "text": "夜のドライブ、悪くないわね。付き合ってあげる。",
   "hash": "ac303138"
  },
  {
   "n": 8,
   "text": "暗いから、歩行者には気をつけて。",
   "hash": "a61b0a07"
  },
  {
   "n": 9,
   "text": "こんな時間に?眠いなら、今日はやめておきなさい。",
   "hash": "33bcab29"
  },
  {
   "n": 10,
   "text": "キミ、無理はしない約束でしょ。",
   "hash": "6a61974d"
  },
  {
   "n": 11,
   "text": "何?",
   "hash": "954ac91d"
  },
  {
   "n": 12,
   "text": "…そんなに見つめられても困るんだけど。",
   "hash": "6a604981"
  },
  {
   "n": 13,
   "text": "ふふ、退屈なの?",
   "hash": "e11da437"
  },
  {
   "n": 14,
   "text": "水、持った?運転中は喉が渇くわよ。",
   "hash": "7a9d55b5"
  },
  {
   "n": 15,
   "text": "キミの運転、嫌いじゃないわ。",
   "hash": "56713951"
  },
  {
   "n": 16,
   "text": "しつこい。…停まってる間だけよ、許すのは。",
   "hash": "62c32e49"
  },
  {
   "n": 17,
   "text": "出発前の確認、しておきましょうか。",
   "hash": "6e7c8d1d"
  },
  {
   "n": 18,
   "text": "ベルト、よし。",
   "hash": "3e0e82c3"
  },
  {
   "n": 19,
   "text": "ミラーと座席も、問題なし。",
   "hash": "642815ce"
  },
  {
   "n": 20,
   "text": "ライト点灯、確認したわ。",
   "hash": "04d6f559"
  },
  {
   "n": 21,
   "text": "行き先もセット済みね。運転中にスマホは触らないこと。",
   "hash": "60611b9e"
  },
  {
   "n": 22,
   "text": "準備完了。行きましょう。",
   "hash": "c02d871d"
  },
  {
   "n": 23,
   "text": "出発ね。安全運転で。",
   "hash": "0ac3fb37"
  },
  {
   "n": 24,
   "text": "じゃあ、行きましょうか。道案内は任せて。",
   "hash": "8055a854"
  },
  {
   "n": 25,
   "text": "確認なしで行くの?…ベルトだけは締めなさいよ。",
   "hash": "4dc372e4"
  },
  {
   "n": 26,
   "text": "深夜の運転よ。眠くなったら、すぐ停まること。いいわね?",
   "hash": "7ad26082"
  },
  {
   "n": 27,
   "text": "1時間経過。肩に力、入ってない?",
   "hash": "4786a26c"
  },
  {
   "n": 28,
   "text": "2時間経過。肩に力、入ってない?",
   "hash": "a9ee5427"
  },
  {
   "n": 29,
   "text": "3時間経過。肩に力、入ってない?",
   "hash": "d21ac3be"
  },
  {
   "n": 30,
   "text": "4時間経過。肩に力、入ってない?",
   "hash": "16246ef1"
  },
  {
   "n": 31,
   "text": "5時間経過。肩に力、入ってない?",
   "hash": "82236ff8"
  },
  {
   "n": 32,
   "text": "6時間経過。肩に力、入ってない?",
   "hash": "5fe02643"
  },
  {
   "n": 33,
   "text": "7時間経過。肩に力、入ってない?",
   "hash": "4be1233a"
  },
  {
   "n": 34,
   "text": "8時間経過。肩に力、入ってない?",
   "hash": "a62c447d"
  },
  {
   "n": 35,
   "text": "9時間経過。肩に力、入ってない?",
   "hash": "7f5c1c04"
  },
  {
   "n": 36,
   "text": "10時間経過。肩に力、入ってない?",
   "hash": "24053894"
  },
  {
   "n": 37,
   "text": "この道、景色がいいわね。",
   "hash": "42776ee7"
  },
  {
   "n": 38,
   "text": "音楽でもかける?運転に集中できる範囲でね。",
   "hash": "245ad846"
  },
  {
   "n": 39,
   "text": "順調ね。このペースでいきましょう。",
   "hash": "099f34cb"
  },
  {
   "n": 40,
   "text": "30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "188c5bab"
  },
  {
   "n": 41,
   "text": "1時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "34d95222"
  },
  {
   "n": 42,
   "text": "1時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "07e6ad49"
  },
  {
   "n": 43,
   "text": "2時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "e1788701"
  },
  {
   "n": 44,
   "text": "2時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "947a3bd0"
  },
  {
   "n": 45,
   "text": "3時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "273c6ed4"
  },
  {
   "n": 46,
   "text": "3時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "8b469767"
  },
  {
   "n": 47,
   "text": "4時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "0f1b047b"
  },
  {
   "n": 48,
   "text": "4時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "a52319f6"
  },
  {
   "n": 49,
   "text": "5時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "dad527fe"
  },
  {
   "n": 50,
   "text": "5時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "217ada05"
  },
  {
   "n": 51,
   "text": "6時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "c8ccefcd"
  },
  {
   "n": 52,
   "text": "6時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "0498bd0c"
  },
  {
   "n": 53,
   "text": "7時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "338fc280"
  },
  {
   "n": 54,
   "text": "7時間30分運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "1accc4a3"
  },
  {
   "n": 55,
   "text": "8時間運転したわ。次のサービスエリアかコンビニで休憩しましょう。",
   "hash": "15992c17"
  },
  {
   "n": 56,
   "text": "まだ休んでないわよね。次で停まって。これはお願いじゃなくて、指示。",
   "hash": "a8d85d05"
  },
  {
   "n": 57,
   "text": "いい判断。ちゃんと休める人は、運転も上手よ。",
   "hash": "b269be74"
  },
  {
   "n": 58,
   "text": "少し体を伸ばしておきなさい。楽になるから。",
   "hash": "d9c31ffa"
  },
  {
   "n": 59,
   "text": "到着。短い距離でも、お疲れさま。",
   "hash": "df8e4fb6"
  },
  {
   "n": 60,
   "text": "お疲れさま、キミ。無事に着いて何より。",
   "hash": "c2dd042f"
  },
  {
   "n": 61,
   "text": "長かったわね。今日はよく頑張ったわ。",
   "hash": "ec765039"
  },
  {
   "n": 62,
   "text": "本当にお疲れさま。今日はもう、ゆっくり休みなさい。",
   "hash": "e9e3565e"
  },
  {
   "n": 63,
   "text": "休憩の取り方も、満点よ。",
   "hash": "111296be"
  },
  {
   "n": 64,
   "text": "でも休憩なしは感心しないわ。次はちゃんと停まること。",
   "hash": "9377d377"
  },
  {
   "n": 65,
   "text": "遅くまでお疲れさま。早く寝なさいね。",
   "hash": "7c36fc68"
  },
  {
   "n": 66,
   "text": "記録しておいたわ。また呼んで。",
   "hash": "c67c8c6b"
  },
  {
   "n": 67,
   "text": "わかった、今回は記録しないでおくわね。",
   "hash": "9925b832"
  },
  {
   "n": 68,
   "text": "なかよし度が「顔見知り」になったみたい。…悪くない響きね。",
   "hash": "4d11240d"
  },
  {
   "n": 69,
   "text": "なかよし度が「ドライブ仲間」になったみたい。…悪くない響きね。",
   "hash": "afee2a58"
  },
  {
   "n": 70,
   "text": "なかよし度が「相棒見習い」になったみたい。…悪くない響きね。",
   "hash": "17074a7c"
  },
  {
   "n": 71,
   "text": "なかよし度が「相棒」になったみたい。…悪くない響きね。",
   "hash": "eef30469"
  },
  {
   "n": 72,
   "text": "なかよし度が「名コンビ」になったみたい。…悪くない響きね。",
   "hash": "c69da4e9"
  },
  {
   "n": 73,
   "text": "これで5回目。キミとのドライブにも、慣れてきたわ。",
   "hash": "f6e046c8"
  },
  {
   "n": 74,
   "text": "これで10回目。キミとのドライブにも、慣れてきたわ。",
   "hash": "342e2508"
  },
  {
   "n": 75,
