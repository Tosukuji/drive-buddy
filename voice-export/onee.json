  },
  {
   "n": 234,
   "text": "今日はクリスマスね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "f59a8f89"
  },
  {
   "n": 235,
   "text": "今日は大晦日ね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "c047615c"
  },
  {
   "n": 236,
   "text": "キミと走り始めて、もう30日。…あっという間ね。これからもよろしく。",
   "hash": "79b59239"
  },
  {
   "n": 237,
   "text": "キミと走り始めて、もう100日。…あっという間ね。これからもよろしく。",
   "hash": "c9d1e561"
  },
  {
   "n": 238,
   "text": "キミと走り始めて、もう365日。…あっという間ね。これからもよろしく。",
   "hash": "6543f5ec"
  },
  {
   "n": 239,
   "text": "撮るの?…いいわよ、きれいに撮ってね。",
   "hash": "e7da2733"
  },
  {
   "n": 240,
   "text": "「はじめてのドライブ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "bc94969a"
  },
  {
   "n": 241,
   "text": "「常連さん」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "eed46ceb"
  },
  {
   "n": 242,
   "text": "「名コンビ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "827928a4"
  },
  {
   "n": 243,
   "text": "「10時間いっしょ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "223d3cc7"
  },
  {
   "n": 244,
   "text": "「1000キロの旅」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "d99b73b8"
  },
  {
   "n": 245,
   "text": "「確認上手」達成ね。ちゃんと積み重ねてるじゃない。",
