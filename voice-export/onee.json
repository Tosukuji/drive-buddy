  },
  {
   "n": 225,
   "text": "ね。ありがたくもらっておくわ。",
   "hash": "2046786e"
  },
  {
   "n": 226,
   "text": "正直、苦手なのよ。次はもう少し考えてね。",
   "hash": "8ed37fc0"
  },
  {
   "n": 227,
   "text": "雨ね。路面が滑るから、スピードは控えめに。",
   "hash": "dea21800"
  },
  {
   "n": 228,
   "text": "今日は元日ね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "4914d1a2"
  },
  {
   "n": 229,
   "text": "今日はバレンタインね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "2cdc2b0d"
  },
  {
   "n": 230,
   "text": "今日はひな祭りね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "e0df4749"
  },
  {
   "n": 231,
   "text": "今日は七夕ね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "10b56712"
  },
  {
   "n": 232,
   "text": "今日はハロウィンね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "e32edcf8"
  },
  {
   "n": 233,
   "text": "今日はクリスマスイブね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "b21132ab"
  },
  {
   "n": 234,
   "text": "今日はクリスマスね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "f59a8f89"
  },
  {
   "n": 235,
   "text": "今日は大晦日ね。浮かれすぎない程度に、楽しみましょ。",
   "hash": "c047615c"
  },
  {
   "n": 236,
   "text": "キミと走り始めて、もう30日。…あっという間ね。これからもよろしく。",
   "hash": "79b59239"
  },
  {
   "n": 237,
   "text": "キミと走り始めて、もう100日。…あっという間ね。これからもよろしく。",
   "hash": "c9d1e561"
  },
  {
   "n": 238,
   "text": "キミと走り始めて、もう365日。…あっという間ね。これからもよろしく。",
   "hash": "6543f5ec"
  },
  {
   "n": 239,
   "text": "撮るの?…いいわよ、きれいに撮ってね。",
   "hash": "e7da2733"
  },
  {
   "n": 240,
   "text": "「はじめてのドライブ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "bc94969a"
  },
  {
   "n": 241,
   "text": "「常連さん」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "eed46ceb"
  },
  {
   "n": 242,
   "text": "「名コンビ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "827928a4"
  },
  {
   "n": 243,
   "text": "「10時間いっしょ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "223d3cc7"
  },
  {
   "n": 244,
   "text": "「1000キロの旅」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "d99b73b8"
  },
  {
   "n": 245,
   "text": "「確認上手」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "ccd61eac"
  },
  {
   "n": 246,
   "text": "「休憩上手」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "3a74882f"
  },
  {
   "n": 247,
   "text": "「なめらか運転」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "740a7152"
  },
  {
   "n": 248,
   "text": "「朝のドライブ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "64148be5"
  },
  {
   "n": 249,
   "text": "「5県めぐり」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "a8bfe46a"
  },
  {
   "n": 250,
   "text": "「20県めぐり」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "c3782785"
  },
  {
   "n": 251,
   "text": "「おみやげ好き」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "c7bad695"
  },
  {
   "n": 252,
   "text": "「レアもの」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "826f13ac"
  },
  {
   "n": 253,
   "text": "「プレゼント上手」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "536985dd"
  },
  {
   "n": 254,
   "text": "「聞き上手」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "3f78b3b0"
  },
  {
   "n": 255,
   "text": "「最高の相棒」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "a497f648"
  },
  {
   "n": 256,
   "text": "「はい、チーズ」達成ね。ちゃんと積み重ねてるじゃない。",
   "hash": "5a5728e5"
  },
  {
   "n": 257,
   "text": "運転もなめらかで、いい乗り心地だったわ。",
   "hash": "c12bbb98"
  },
  {
   "n": 258,
   "text": "ただ、ブレーキが急な場面がいくつかあったわ。車間はもう少し空けて。",
