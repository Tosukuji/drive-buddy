   "hash": "750b8954"
  },
  {
   "n": 127,
   "text": "デモ走行だね!120倍速でいくよ!2時間が1分くらい!",
   "hash": "ac3fca0d"
  },
  {
   "n": 128,
   "text": "デモおしまい!本番も楽しみにしてるね!",
   "hash": "81dcf32e"
  },
  {
   "n": 129,
   "text": "こんな声だよ!聞こえるー?",
   "hash": "0eb0bd53"
  },
  {
   "n": 130,
   "text": "あれ、なんか見た目変わった?どう?似合う?",
   "hash": "dffe881c"
  },
  {
   "n": 131,
   "text": "ヒナタだよ!今日から相棒と一緒に走るね!よろしく!",
   "hash": "618eda16"
  },
  {
   "n": 132,
   "text": "この先4キロで海老名サービスエリアだよ!営業24時間、混雑。寄ってく?",
   "hash": "bc8a8c42"
  },
  {
   "n": 133,
   "text": "この先4キロで海老名サービスエリアだよ!寄ってく?",
   "hash": "f2112093"
  },
  {
   "n": 134,
   "text": "この先3キロで鮎沢パーキングエリアだよ!営業24時間、空いている。寄ってく?",
   "hash": "7d4105bd"
  },
  {
   "n": 135,
   "text": "この先3キロで鮎沢パーキングエリアだよ!寄ってく?",
   "hash": "edd89cdf"
  },
  {
   "n": 136,
   "text": "この先6キロで足柄サービスエリアだよ!営業24時間、やや混雑。寄ってく?",
   "hash": "5d9f73aa"
  },
  {
   "n": 137,
   "text": "この先6キロで足柄サービスエリアだよ!寄ってく?",
   "hash": "d1f2972b"
  },
  {
   "n": 138,
   "text": "この先2キロで道の駅すばしりだよ!営業8時から18時、空いている。寄ってく?",
   "hash": "c528aab7"
  },
  {
   "n": 139,
   "text": "この先2キロで道の駅すばしりだよ!寄ってく?",
   "hash": "c337a67d"
  },
  {
   "n": 140,
