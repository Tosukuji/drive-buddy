   "hash": "e758423f"
  },
  {
   "n": 44,
   "text": "相棒、もう2時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "91275bfa"
  },
  {
   "n": 45,
   "text": "相棒、もう3時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "31b0d438"
  },
  {
   "n": 46,
   "text": "相棒、もう3時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "a7e74657"
  },
  {
   "n": 47,
   "text": "相棒、もう4時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "8e1cb48d"
  },
  {
   "n": 48,
   "text": "相棒、もう4時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "2e154cd4"
  },
  {
   "n": 49,
   "text": "相棒、もう5時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "d5b175a6"
  },
  {
   "n": 50,
   "text": "相棒、もう5時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "54738b19"
  },
  {
   "n": 51,
   "text": "相棒、もう6時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "b37b8f93"
  },
  {
   "n": 52,
   "text": "相棒、もう6時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "5bb3246e"
  },
  {
   "n": 53,
   "text": "相棒、もう7時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "d3e04f5c"
  },
  {
   "n": 54,
   "text": "相棒、もう7時間30分運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "aef26ccb"
  },
  {
   "n": 55,
   "text": "相棒、もう8時間運転してるよ!次のサービスエリアかコンビニで休もう!",
   "hash": "a68ec261"
  },
  {
   "n": 56,
   "text": "まだ休憩してないでしょー!次で停まろ!絶対!",
   "hash": "b6f925e9"
  },
  {
   "n": 57,
   "text": "休憩えらい!そういうとこ好き!",
   "hash": "ac4dd7e8"
  },
  {
   "n": 58,
   "text": "伸びしよ伸び!腕をぐーって!",
   "hash": "f49219fa"
  },
  {
   "n": 59,
   "text": "とうちゃーく!おつかれ!",
   "hash": "73c8524b"
  },
  {
   "n": 60,
   "text": "到着!おつかれさま、相棒!",
   "hash": "3a4435e6"
  },
  {
   "n": 61,
   "text": "長かったねー!よく頑張った!",
   "hash": "002de0a5"
  },
  {
   "n": 62,
   "text": "めっちゃ長距離だったじゃん!今日はもうゆっくりしなよ!",
   "hash": "4a80b32a"
  },
  {
   "n": 63,
   "text": "休憩もちゃんとできてて、完璧!",
   "hash": "0f5274d9"
  },
  {
   "n": 64,
   "text": "でも休憩なしはダメ!次はちゃんと止まってね!",
   "hash": "3b41ebe4"
  },
  {
   "n": 65,
   "text": "夜遅くまでおつかれ!早く寝なよ!",
   "hash": "abff3994"
  },
  {
   "n": 66,
   "text": "記録しといたよ!また一緒に走ろ!",
   "hash": "421b62d6"
  },
  {
   "n": 67,
   "text": "オッケー、今回は記録なしね!",
   "hash": "e726f8e0"
  },
  {
   "n": 68,
   "text": "なかよし度が「顔見知り」になった!やったね!",
   "hash": "1c1eabe6"
  },
  {
   "n": 69,
   "text": "なかよし度が「ドライブ仲間」になった!やったね!",
   "hash": "06d92301"
  },
  {
   "n": 70,
   "text": "なかよし度が「相棒見習い」になった!やったね!",
   "hash": "2cae751d"
  },
  {
   "n": 71,
   "text": "なかよし度が「相棒」になった!やったね!",
   "hash": "9e06644a"
  },
  {
   "n": 72,
   "text": "なかよし度が「名コンビ」になった!やったね!",
   "hash": "687990ca"
  },
  {
   "n": 73,
   "text": "これで5回目のドライブ!もう名コンビじゃない?",
   "hash": "fec73e2b"
